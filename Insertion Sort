#include <iostream>
using namespace std;

void insertionSort(int arr[]) {
    int j = 0;
    int key = 0 ;
    for(int i=0; i<5; i++) {
        key = arr[i];
        j = i - 1;
        while(j >= 0 && arr[j] > key) {
            arr[j+1] = arr[j];
            j = j - 1;
        }
        arr[j+1] = key;
    }
    
}


int main() {
    int myarray[5];
    cout << "Enter 5 numbers: ";
    for(int i=0; i<5; i++) {
        cin >> myarray[i];
    }
    cout << "Before Sorting: " << endl;
    for(int j=0; j<5; j++) {
        cout << myarray[j] << " ";
    }
    
    cout << endl;
    insertionSort(myarray);
    
    for(int k=0; k<5; k++) {
        cout << myarray[k] << " ";
    }
    
}
